# ─── Vertex AI / Gemma ────────────────────────────────────────────────────────
# Project ID dari akun Gemini Enterprise Agent yang dikasih panitia hackathon
GOOGLE_CLOUD_PROJECT=YOUR_PROJECT_ID

# "global" sesuai snippet resmi. Bisa diganti ke region spesifik (us-central1, dst)
VERTEX_REGION=global

# Host API. Untuk region non-global pakai: <REGION>-aiplatform.googleapis.com
VERTEX_ENDPOINT=aiplatform.googleapis.com

# Model Gemma di Model Garden
GEMMA_MODEL=google/gemma-4-26b-a4b-it-maas

# Default generation params (opsional)
GEMMA_MAX_TOKENS=8192
GEMMA_TEMPERATURE=0.7
# Thinking default MATI. Diukur pada gemma-4-26b: reasoning memakan ~1.900 karakter
# sebelum jawaban ditulis, sehingga output panjang terpotong dan latensi naik jauh.
# Isi "true" hanya kalau memang ingin melihat jejak penalarannya.
GEMMA_ENABLE_THINKING=false

# ─── Kredensial (pilih SALAH SATU) ───────────────────────────────────────────
# 1. Service Account key file (paling stabil, tidak butuh gcloud CLI)
# GOOGLE_APPLICATION_CREDENTIALS=./secrets/sa-key.json

# 2. Access token manual — hasil dari `gcloud auth print-access-token`
#    Umurnya ~60 menit. Cocok untuk demo cepat saat hackathon.
# GOOGLE_ACCESS_TOKEN=ya29....

# 3. Tidak set apa-apa → fallback ke gcloud CLI / Application Default Credentials
